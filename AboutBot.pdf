dropout=0.1):
super().__init__()
layers = []
for i, out_ch in enumerate(num_channels):
dilation = 2 ** i
in_ch = input_channels if i == 0 else num_channels[i-1]
padding = (kernel_size - 1) * dilation
layers += [
nn.Conv1d(in_ch, out_ch, kernel_size, padding=padding,
dilation=dilation),
nn.ReLU(),
nn.Dropout(dropout)
]
self.network = nn.Sequential(*layers)
self.out = nn.Linear(num_channels[-1], 1) # final output to 1 value
def forward(self, x):
# x shape: (batch, channels, sequence_length)
y = self.network(x)
# Crop extra padded time steps (causal conv extends output length by
padding)
y = y[..., :x.size(2)]
# Use last time-step for prediction
y = y[:, :, -1] # shape: (batch, num_channels[-1])
y = self.out(y) # shape: (batch, 1)
return torch.sigmoid(y).squeeze(1)
# Example usage:
model = SimpleTCN(input_channels=4, num_channels=[16, 16, 8], kernel_size=3,
dropout=0.1)
print(model)
Training loop: After loading your preprocessed data into training tensors (X in shape (N, C, L) , and
binary labels y as shape (N,) ), train as usual:
criterion = nn.BCELoss() # binary cross-entropy for up/down
optimizer = optim.Adam(model.parameters(), lr=1e-3)
for epoch in range(num_epochs):
model.train()
epoch_loss = 0
for X_batch, y_batch in train_loader: # assume DataLoader yielding batches
optimizer.zero_grad()
preds = model(X_batch) # outputs in [0,1]
loss = criterion(preds, y_batch.float())
loss.backward()
